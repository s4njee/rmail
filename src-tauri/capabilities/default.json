{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window. Deny-by-default: nothing is granted here except the core defaults plus opener for external links. Per-permission rationale: see capabilities/README.md.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "updater:default",
    "log:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$APPDATA/attachments/**" }]
    },
    "core:tray:default",
    "core:tray:allow-new",
    "core:tray:allow-set-icon",
    "core:tray:allow-set-menu",
    "core:tray:allow-set-tooltip",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus"
  ]
}
