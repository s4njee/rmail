{
  "name": "@rcalendar/ui",
  "version": "0.1.0",
  "description": "Framework-agnostic SolidJS calendar components with a pluggable data source seam for Almanac.",
  "type": "module",
  "license": "MIT",
  "author": "Almanac Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/rcalendar/rcalendar.git",
    "directory": "packages/calendar-ui"
  },
  "homepage": "https://github.com/rcalendar/rcalendar",
  "keywords": [
    "calendar",
    "solidjs",
    "agenda",
    "month-view",
    "week-view",
    "time-grid",
    "embeddable"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/tokens/tokens.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens.css": {
      "import": "./dist/tokens/tokens.css",
      "default": "./dist/tokens/tokens.css"
    },
    "./tokens": {
      "import": "./dist/tokens/tokens.css",
      "default": "./dist/tokens/tokens.css"
    },
    "./dist/*": "./dist/*",
    "./*": "./dist/*"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"const fs = require('fs'); fs.mkdirSync('dist/tokens', {recursive:true}); fs.copyFileSync('src/tokens/tokens.css', 'dist/tokens/tokens.css'); fs.copyFileSync('src/tokens/tokens.css', 'dist/tokens.css'); fs.copyFileSync('src/tokens/tokens.css', 'tokens.css');\"",
    "test": "vitest run"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "solid-js": "^1.9.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
